
import sys
import shutil
import subprocess

from PySide6.QtWidgets import (
    QApplication, QWidget, QLabel,
    QPushButton, QVBoxLayout, QMessageBox
)
from PySide6.QtCore import Qt


STYLE = """
QWidget {
    background: #0b0912;
    color: white;
    font-family: sans-serif;
}
QLabel#title {
    color: #c084fc;
    font-size: 32px;
    font-weight: bold;
}
QPushButton {
    background: #9333ea;
    color: white;
    border: none;
    border-radius: 10px;
    padding: 14px;
    font-weight: bold;
}
QPushButton:hover {
    background: #a855f7;
}
"""


class NDILStore(QWidget):
    def __init__(self):
        super().__init__()

        self.setWindowTitle("NDIL Store")
        self.resize(520, 350)

        layout = QVBoxLayout(self)
        layout.setContentsMargins(35, 35, 35, 35)
        layout.setSpacing(18)

        title = QLabel("NDIL STORE")
        title.setObjectName("title")
        title.setAlignment(Qt.AlignmentFlag.AlignCenter)

        subtitle = QLabel(
            "Uygulamalarını keşfet.\n"
            "Yeni araçlar yükle ve sistemini geliştir."
        )
        subtitle.setAlignment(Qt.AlignmentFlag.AlignCenter)

        self.status = QLabel("Mağaza hazır.")
        self.status.setAlignment(Qt.AlignmentFlag.AlignCenter)

        open_button = QPushButton("Mağazayı Aç")
        open_button.clicked.connect(self.open_discover)

        layout.addStretch()
        layout.addWidget(title)
        layout.addWidget(subtitle)
        layout.addWidget(open_button)
        layout.addWidget(self.status)
        layout.addStretch()

        self.setStyleSheet(STYLE)

    def open_discover(self):
        executable = shutil.which("plasma-discover")

        if not executable:
            QMessageBox.warning(
                self,
                "NDIL Store",
                "KDE Discover bulunamadı.\n"
                "NDIL OS üzerinde plasma-discover "
                "paketinin kurulması gerekiyor."
            )
            return

        try:
            subprocess.Popen(
                [executable],
                start_new_session=True
            )
            self.status.setText("KDE Discover açıldı.")

        except OSError as error:
            QMessageBox.warning(
                self, "Başlatma hatası", str(error)
            )


if __name__ == "__main__":
    app = QApplication(sys.argv)
    window = NDILStore()
    window.show()
    sys.exit(app.exec())
