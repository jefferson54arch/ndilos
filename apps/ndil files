
import sys
from pathlib import Path

from PySide6.QtWidgets import (
    QApplication, QMainWindow, QWidget, QLabel,
    QPushButton, QLineEdit, QTreeView, QVBoxLayout,
    QHBoxLayout, QFileSystemModel, QMessageBox
)
from PySide6.QtCore import QDir, QUrl
from PySide6.QtGui import QDesktopServices

STYLE = """
QWidget {
    background: #0b0912;
    color: #eeeeff;
    font-family: sans-serif;
    font-size: 14px;
}
QLabel#title {
    color: #c084fc;
    font-size: 27px;
    font-weight: bold;
}
QLineEdit {
    background: #181222;
    border: 1px solid #693c91;
    border-radius: 8px;
    padding: 10px;
}
QPushButton {
    background: #352044;
    border: 1px solid #693c91;
    border-radius: 8px;
    padding: 10px;
}
QPushButton:hover {
    background: #7025a8;
}
QTreeView {
    background: #15111e;
    alternate-background-color: #1c1528;
    border: 1px solid #493064;
    border-radius: 8px;
    selection-background-color: #7025a8;
    padding: 5px;
}
QHeaderView::section {
    background: #211632;
    color: #c084fc;
    padding: 8px;
    border: none;
}
"""

class NDILFiles(QMainWindow):
    def __init__(self):
        super().__init__()

        self.setWindowTitle("NDIL Files")
        self.resize(950, 650)

        self.current_path = str(Path.home())

        root = QWidget()
        layout = QVBoxLayout(root)
        layout.setContentsMargins(22, 20, 22, 20)

        title = QLabel("NDIL FILES")
        title.setObjectName("title")

        subtitle = QLabel("Dosya yöneticisi")

        toolbar = QHBoxLayout()

        self.back_button = QPushButton("Ana Klasör")
        self.up_button = QPushButton("Yukarı")
        self.go_button = QPushButton("Git")

        self.address = QLineEdit(self.current_path)
        self.address.returnPressed.connect(self.go_to_address)

        self.back_button.clicked.connect(self.go_home)
        self.up_button.clicked.connect(self.go_up)
        self.go_button.clicked.connect(self.go_to_address)

        toolbar.addWidget(self.back_button)
        toolbar.addWidget(self.up_button)
        toolbar.addWidget(self.address, 1)
        toolbar.addWidget(self.go_button)

        self.model = QFileSystemModel(self)
        self.model.setFilter(
            QDir.Filter.AllEntries |
            QDir.Filter.NoDotAndDotDot |
            QDir.Filter.Hidden
        )
        self.model.setRootPath(self.current_path)

        self.tree = QTreeView()
        self.tree.setModel(self.model)
        self.tree.setRootIndex(
            self.model.index(self.current_path)
        )
        self.tree.setAlternatingRowColors(True)
        self.tree.setSortingEnabled(True)
        self.tree.doubleClicked.connect(self.open_item)

        self.tree.setColumnWidth(0, 350)
        self.tree.setColumnWidth(1, 110)
        self.tree.setColumnWidth(2, 130)

        layout.addWidget(title)
        layout.addWidget(subtitle)
        layout.addLayout(toolbar)
        layout.addWidget(self.tree)

        self.setCentralWidget(root)
        self.setStyleSheet(STYLE)

    def navigate(self, path):
        folder = Path(path).expanduser()

        if not folder.exists() or not folder.is_dir():
            QMessageBox.warning(
                self,
                "NDIL Files",
                "Bu klasör bulunamadı."
            )
            return

        self.current_path = str(folder.resolve())
        self.address.setText(self.current_path)
        self.tree.setRootIndex(
            self.model.index(self.current_path)
        )

    def go_home(self):
        self.navigate(str(Path.home()))

    def go_up(self):
        parent = Path(self.current_path).parent
        self.navigate(str(parent))

    def go_to_address(self):
        self.navigate(self.address.text())

    def open_item(self, index):
        path = self.model.filePath(index)

        if self.model.isDir(index):
            self.navigate(path)
        else:
            opened = QDesktopServices.openUrl(
                QUrl.fromLocalFile(path)
            )

            if not opened:
                QMessageBox.warning(
                    self,
                    "NDIL Files",
                    "Dosya açma işlemi başarısız oldu."
                )


if __name__ == "__main__":
    app = QApplication(sys.argv)

    window = NDILFiles()
    window.show()

    sys.exit(app.exec())
